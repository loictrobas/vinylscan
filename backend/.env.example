# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/vinylscan

# Auth
SECRET_KEY=your-secret-key-min-32-chars-change-this
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this

# Optional — overrides the auto-seeded admin account created on first boot.
# Leave unset to get loictrobas1@gmail.com / loicisadmin (fine for solo local dev,
# set your own if working alongside someone else on a shared or public repo).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Discogs OAuth
DISCOGS_CONSUMER_KEY=your_discogs_consumer_key
DISCOGS_CONSUMER_SECRET=your_discogs_consumer_secret

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe (test mode keys — dashboard.stripe.com, ask whoever owns the account)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_CREDITS_50=price_...

# Cloudinary (store logo/banner uploads) — ask whoever owns the account
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DEV_MODE=true

# Image storage — Cloudflare R2 (production only)
# Leave empty to use local disk storage (dev default: backend/data/images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vinylscan-images
R2_PUBLIC_URL=https://your-r2-domain.com

# Optional — only needed to hit REDIS_URL-backed SSE across multiple workers;
# leave unset for local dev (falls back to in-memory SSE)
REDIS_URL=
